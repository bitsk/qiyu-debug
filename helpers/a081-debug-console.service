[Unit]
Description=MIX read-only tracking and screen debug console
After=network-online.target a081-remote-view.service
PartOf=a081-remote-view.service

[Service]
Type=simple
EnvironmentFile=/var/lib/mix-steamos/remote-view.env
Environment=LD_LIBRARY_PATH=/opt/mix-remote-video/lib
Environment=GST_PLUGIN_PATH_1_0=/opt/mix-remote-video/lib/gstreamer-1.0
Environment=GST_REGISTRY=/run/mix-camera-preview/gst-registry.bin
ExecStartPre=/usr/bin/rm -f /run/mix-camera-preview/frames.sock /run/mix-camera-preview/gst-registry.bin
ExecStartPre=/opt/mix-debug-console/mix-debug-server --wait-address ${MIX_VIEW_ADDRESS} --timeout 60
TimeoutStartSec=65
ExecStart=/opt/mix-debug-console/mix-debug-server --listen ${MIX_VIEW_ADDRESS} --token-file /var/lib/mix-debug-console/access.token --session-file /run/mix-vr-shell-controller/session.json
KillMode=control-group
TimeoutStopSec=8
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=mix-camera-preview mix-video-control
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN CAP_SETUID CAP_SETGID

[Install]
WantedBy=a081-remote-view.service
